{
  "name": "colegio-api-core",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevelopersCI/colegio-api-core"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "cross-env NODE_ENV=development tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start:debug": "cross-env NODE_ENV=development tsc-watch -p tsconfig.build.json --onSuccess \"node --inspect-brk dist/main.js\"",
    "start:prod": "cross-env NODE_ENV=production node dist/main.js",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --config src/ormconfig.ts --connection colegiodb",
    "typeorm:migrate": "npm run typeorm migration:generate -- -n",
    "typeorm:run": "npm run typeorm migration:run",
    "typeorm:revert": "npm run typeorm migration:revert",
    "typeorm:prod": "cross-env NODE_ENV=production ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --config src/ormconfig.ts --connection colegiodb",
    "typeorm:migrate:prod": "npm run typeorm:prod migration:generate -- -n",
    "typeorm:run:prod": "npm run typeorm:prod migration:run",
    "typeorm:test": "cross-env NODE_ENV=testing ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --config src/ormconfig.ts --connection colegiodb",
    "typeorm:migrate:test": "npm run typeorm:test migration:generate -- -n",
    "typeorm:run:test": "npm run typeorm:test migration:run"
  },
  "dependencies": {
    "@hapi/joi": "^16.1.4",
    "@nest-modules/mailer": "^1.1.3",
    "@nestjs/common": "^6.11.6",
    "@nestjs/config": "^0.2.4",
    "@nestjs/core": "^6.11.6",
    "@nestjs/jwt": "^6.1.1",
    "@nestjs/passport": "^6.1.0",
    "@nestjs/platform-express": "^6.11.6",
    "@nestjs/swagger": "^3.1.0",
    "@nestjs/typeorm": "^6.1.3",
    "@nestjsx/crud": "^4.2.0",
    "@nestjsx/crud-typeorm": "^4.2.0",
    "@signati/sdk-node": "0.0.2",
    "@types/express-mysql-session": "^1.2.2",
    "@types/multer": "^1.4.2",
    "@types/xlsx": "0.0.36",
    "bcrypt": "^3.0.6",
    "class-transformer": "^0.2.3",
    "class-validator": "^0.10.0",
    "dotenv": "^8.1.0",
    "exceljs": "^3.7.0",
    "express-mysql-session": "^2.1.3",
    "express-query-boolean": "^2.0.0",
    "express-session": "^1.16.2",
    "immutable": "^4.0.0-rc.12",
    "invoice-modern": "0.0.6",
    "mjml": "^4.5.1",
    "moment": "^2.24.0",
    "moment-timezone": "^0.5.27",
    "multer": "^1.4.2",
    "mysql": "^2.18.1",
    "nest-router": "^1.0.9",
    "node-xlsx": "^0.15.0",
    "passport": "^0.4.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pdfjs": "^2.3.5",
    "reflect-metadata": "^0.1.12",
    "rimraf": "^2.7.1",
    "rxjs": "^6.5.3",
    "serve-favicon": "^2.5.0",
    "soap": "^0.30.0",
    "swagger-ui-express": "^4.1.3",
    "typeorm": "^0.2.19",
    "xlsx": "^0.15.5",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@nestjs/testing": "^6.11.6",
    "@types/bcrypt": "^3.0.0",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.1",
    "@types/express-session": "^1.15.14",
    "@types/hapi__joi": "^15.0.4",
    "@types/jest": "^24.9.1",
    "@types/mjml": "^4.0.3",
    "@types/node": "^12.12.26",
    "@types/node-xlsx": "^0.12.1",
    "@types/passport-jwt": "^3.0.2",
    "@types/passport-local": "^1.0.33",
    "@types/serve-favicon": "^2.2.31",
    "@types/supertest": "^2.0.8",
    "cross-env": "^6.0.0",
    "jest": "^24.9.0",
    "prettier": "1.17.0",
    "supertest": "4.0.2",
    "ts-jest": "24.0.2",
    "ts-node": "8.1.0",
    "tsc-watch": "2.2.1",
    "tsconfig-paths": "3.8.0",
    "tslint": "5.16.0",
    "typescript": "^3.7.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
