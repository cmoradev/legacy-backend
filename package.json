  "repository": {
    "type": "git",
    "url": "https://github.com/DevelopersCI/colegio-api-core"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "cross-env NODE_ENV=development tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start:debug": "cross-env NODE_ENV=development tsc-watch -p tsconfig.build.json --onSuccess \"node --inspect-brk dist/main.js\"",
    "start:prod": "cross-env NODE_ENV=production node dist/main.js",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "cross-env NODE_ENV=${db:-development} ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --config src/ormconfig.ts --connection ${db:-development}",
    "typeorm:migrate": "npm run typeorm  migration:generate -- -n",
    "typeorm:run": "npm run typeorm migration:run",
    "seed": "cross-env NODE_ENV=${db:-development} ts-node -r tsconfig-paths/register ./node_modules/typeorm-seeding/dist/cli.js seed --configName src/ormconfig.ts --connection ${db:-development} --seed ",
    "typeorm:revert": "npm run typeorm migration:revert",
    "orm": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "orm:migrate": "npm run orm migration:generate -- -n",
    "orm:run": "npm run orm migration:run",
    "orm:revert": "npm run orm migration:revert",
    "orm:drop": "npm run orm schema:drop",
    "orm:sync": "npm run orm schema:sync",
    "seeds:run": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register ./node_modules/typeorm-seeding/dist/cli.js seed --configName"
  },
