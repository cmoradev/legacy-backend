{
  "name": "colegio-api-core",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevelopersCI/colegio-api-core"
  },
  "scripts": {
    "prebuild": "rimraf tsconfig.build.tsbuildinfo && rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development && nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production && node dist/main",
    "pdf": "copyfiles  -u 1 \"src/pdf/**/*\" dist",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --config src/ormconfig.ts --connection development",
    "typeorm:migrate": "npm run typeorm  migration:generate -- -n",
    "typeorm:run": "npm run typeorm migration:run",
    "seed": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register ./node_modules/typeorm-seeding/dist/cli.js seed --configName src/ormconfig.ts --seed ",
    "typeorm:revert": "npm run typeorm migration:revert",
    "orm": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "orm:migrate": "npm run orm migration:generate -- -n",
    "orm:run": "npm run orm migration:run",
    "orm:revert": "npm run orm migration:revert",
    "orm:drop": "npm run orm schema:drop",
    "orm:sync": "npm run orm schema:sync",
    "seeds:run": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register ./node_modules/typeorm-seeding/dist/cli.js seed --configName src/ormconfig.ts",
    "init:storage": "bash scripts/init-storage.sh"
  },
  "dependencies": {
    "@hapi/joi": "^17.1.1",
    "@munyaal/calculations": "^1.0.14",
    "@munyaal/cfdi": "^1.0.0-beta.14",
    "@munyaal/cfdi-pdf": "^1.0.3",
    "@nestjs/common": "^7.4.2",
    "@nestjs/core": "^7.4.2",
    "@nestjs/jwt": "^7.1.0",
    "@nestjs/passport": "^7.1.0",
    "@nestjs/platform-express": "^7.4.2",
    "@nestjs/schedule": "^0.4.1",
    "@nestjs/swagger": "^4.5.12",
    "@nestjs/typeorm": "^7.1.0",
    "@nestjsx/crud": "^4.6.2",
    "@nestjsx/crud-typeorm": "^4.6.2",
    "@signati/core": "^4.0.2",
    "@signati/pdf": "0.0.11",
    "adm-zip": "^0.5.5",
    "bcrypt": "^5.1.0",
    "class-transformer": "0.3.1",
    "class-validator": "^0.12.2",
    "date-fns": "^2.30.0",
    "docx": "^5.2.2",
    "dotenv": "^8.2.0",
    "exact-math": "^2.2.0",
    "exceljs": "^4.1.1",
    "express-query-boolean": "^2.0.0",
    "express-session": "^1.17.1",
    "faker": "^5.1.0",
    "immutable": "^4.0.0-rc.12",
    "invoice-modern": "0.0.6",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.31",
    "multer": "^1.4.2",
    "mysql": "npm:mysql2@^2.1.0",
    "mysql2": "^2.3.0",
    "nest-router": "^1.0.9",
    "nestjs-typeorm-paginate": "^2.2.0",
    "node-xlsx": "^0.15.0",
    "nodemailer": "^6.4.11",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pdfmake": "0.1.72",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^6.6.2",
    "serve-favicon": "^2.5.0",
    "sw-sdk-nodejs": "^1.1.4",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.2.45",
    "typeorm-seeding": "^1.6.1",
    "xlsx": "^0.16.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^7.6.0",
    "@nestjs/schematics": "^7.3.1",
    "@nestjs/testing": "^7.4.2",
    "@types/adm-zip": "^0.4.34",
    "@types/bcrypt": "^3.0.0",
    "@types/cron": "^1.7.2",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.7",
    "@types/express-session": "^1.17.0",
    "@types/faker": "^5.1.4",
    "@types/hapi__joi": "^17.1.4",
    "@types/jest": "^27.5.0",
    "@types/lodash": "^4.14.168",
    "@types/multer": "^1.4.3",
    "@types/node": "^14.0.27",
    "@types/node-xlsx": "^0.15.0",
    "@types/nodemailer": "^6.4.0",
    "@types/passport-jwt": "^3.0.3",
    "@types/passport-local": "^1.0.33",
    "@types/serve-favicon": "^2.5.0",
    "@types/supertest": "^2.0.10",
    "@types/xlsx": "0.0.36",
    "@typescript-eslint/eslint-plugin": "^5.50.0",
    "@typescript-eslint/parser": "^5.50.0",
    "cross-env": "^7.0.2",
    "eslint": "^8.33.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^28.0.3",
    "prettier": "2.0.5",
    "rimraf": "^3.0.2",
    "supertest": "4.0.2",
    "ts-jest": "^28.0.1",
    "ts-node": "8.10.2",
    "tsc-watch": "4.2.9",
    "tsconfig-paths": "3.9.0",
    "typescript": "^4.9.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
