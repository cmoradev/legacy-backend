TYPEORM_CONNECTION=mysql

TYPEORM_SYNCHRONIZE=false

TYPEORM_MIGRATIONS_TABLE_NAME=migrations_typeorm
TYPEORM_MIGRATIONS_RUN=false
TYPEORM_LOGGER=simple-console
TYPEORM_LOGGING=all

TYPEORM_HOST=localhost
TYPEORM_PORT=3306
TYPEORM_USERNAME=develop
TYPEORM_PASSWORD=develop
TYPEORM_DATABASE=db_develop

TYPEORM_ENTITIES=src/**/*.entity.ts
TYPEORM_ENTITIES_DIR=src/entities

TYPEORM_MIGRATIONS=src/migrations/**/*.ts
TYPEORM_MIGRATIONS_DIR=src/migrations

TYPEORM_SUBSCRIBERS=src/subscribers/*.ts
TYPEORM_SUBSCRIBERS_DIR=src/subscribers

TYPEORM_SEEDING_FACTORIES=src/databases/factories/*.factory.ts
TYPEORM_SEEDING_SEEDS=src/databases/seeds/*.seed.ts